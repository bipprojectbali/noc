{
  "name": "noc",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot ./src/server/server.entry.ts",
    "start": "bun ./src/server/server.entry.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:binary": "bun run ./scripts/binary.build.ts",
